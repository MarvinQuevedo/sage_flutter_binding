{
  "name": "ozone-web-extension",
  "version": "0.0.1",
  "private": true,
  "description": "Ozone — Chia browser extension wallet (Goby-compatible, coinset.org sync)",
  "type": "module",
  "scripts": {
    "wasm:build": "cd .. && CC_wasm32_unknown_unknown=/usr/local/opt/llvm/bin/clang AR_wasm32_unknown_unknown=/usr/local/opt/llvm/bin/llvm-ar wasm-pack build vendor/sage/crates/sage-wasm --target web --out-dir ../../../../ozone-web-extension/packages/wallet-wasm --release",
    "wasm:build:dev": "cd .. && CC_wasm32_unknown_unknown=/usr/local/opt/llvm/bin/clang AR_wasm32_unknown_unknown=/usr/local/opt/llvm/bin/llvm-ar wasm-pack build vendor/sage/crates/sage-wasm --target web --out-dir ../../../../ozone-web-extension/packages/wallet-wasm --dev",
    "dev": "pnpm --filter @ozone/extension dev",
    "build": "pnpm wasm:build && pnpm --filter @ozone/extension build",
    "zip": "pnpm --filter @ozone/extension zip",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.10.0"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  }
}
